<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Valentine Proposal</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            width: 100%;
            height: 100vh;
            background: linear-gradient(135deg, #ff1493, #ff69b4);
            font-family: 'Arial', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .container {
            position: relative;
            z-index: 10;
            text-align: center;
        }

        .proposal-box {
            background: rgba(255, 255, 255, 0.95);
            padding: 60px 50px;
            border-radius: 20px;
            box-shadow: 0 0 50px rgba(0, 0, 0, 0.2);
            max-width: 500px;
            animation: slideUp 0.5s ease-out;
            transition: opacity 0.5s;
        }

        .proposal-box.hide {
            opacity: 0;
            pointer-events: none;
        }

        @keyframes slideUp {
            from {
                transform: translateY(50px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .question {
            font-size: 32px;
            color: #ff1493;
            margin-bottom: 20px;
            font-weight: bold;
            letter-spacing: 1px;
            line-height: 1.4;
        }

        .ring {
            font-size: 60px;
            margin-bottom: 30px;
            animation: ringRotate 2s ease-in-out infinite;
        }

        @keyframes ringRotate {
            0%, 100% { transform: rotate(0deg); }
            50% { transform: rotate(20deg); }
        }

        .options {
            display: flex;
            gap: 20px;
            margin-top: 40px;
            justify-content: center;
            flex-wrap: wrap;
            position: relative;
        }

        .option-btn {
            padding: 12px 30px;
            font-size: 16px;
            font-weight: bold;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
        }

        .yes-btn {
            background: linear-gradient(135deg, #ff1493, #ff69b4);
            color: white;
            box-shadow: 0 0 20px rgba(255, 20, 147, 0.3);
        }

        .yes-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 0 40px rgba(255, 20, 147, 0.6);
        }

        .yes-btn:active {
            transform: scale(0.95);
        }

        .no-btn {
            background: #e0e0e0;
            color: #333;
            transition: all 0.1s;
        }

        .no-btn:hover {
            background: #d0d0d0;
        }

        /* Heart shower */
        .falling-heart {
            position: fixed;
            font-size: 40px;
            opacity: 0.8;
            pointer-events: none;
            z-index: 5;
        }

        @keyframes heartfall {
            to {
                transform: translateY(100vh) rotate(720deg);
                opacity: 0;
            }
        }

        /* Gift box container */
        .gift-container {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
            z-index: 20;
            transition: opacity 0.5s;
            pointer-events: none;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        .gift-container.show {
            opacity: 1;
            pointer-events: all;
        }

        .gift-box {
            font-size: 120px;
            cursor: pointer;
            animation: giftBounce 0.8s ease-in-out infinite;
            transition: transform 0.3s;
            filter: drop-shadow(0 0 20px rgba(255, 20, 147, 0.5));
        }

        .gift-box:hover {
            transform: scale(1.1);
            filter: drop-shadow(0 0 40px rgba(255, 20, 147, 0.8));
        }

        @keyframes giftBounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        .gift-instruction {
            font-size: 18px;
            color: white;
            font-weight: bold;
            text-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.7; }
            50% { transform: scale(1.05); opacity: 0.9; }
        }

        .final-message {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 38px;
            color: white;
            font-weight: bold;
            text-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
            opacity: 0;
            z-index: 30;
            text-align: center;
            max-width: 90%;
            pointer-events: none;
            line-height: 1.6;
        }

        @keyframes messageAppear {
            0% {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0);
            }
            5% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1);
            }
            95% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1);
            }
            100% {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0.5);
            }
        }

        .final-message.show {
            animation: messageAppear 6s ease-in-out forwards;
        }

        .back-btn {
            position: fixed;
            top: 20px;
            left: 20px;
            padding: 10px 20px;
            background: rgba(255, 255, 255, 0.3);
            color: white;
            border: 2px solid white;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
            z-index: 15;
        }

        .back-btn:hover {
            background: rgba(255, 255, 255, 0.5);
        }

        .back-btn.hide {
            display: none;
        }

        .email-status {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: rgba(255, 255, 255, 0.9);
            padding: 15px 25px;
            border-radius: 8px;
            font-weight: bold;
            z-index: 40;
            opacity: 0;
            transition: opacity 0.5s;
            max-width: 300px;
            word-wrap: break-word;
        }

        .email-status.show {
            opacity: 1;
        }

        .email-status.success {
            color: #28a745;
            border-left: 4px solid #28a745;
        }

        .email-status.error {
            color: #dc3545;
            border-left: 4px solid #dc3545;
        }
    </style>
</head>
<body>
    <button class="back-btn" id="backBtn" onclick="goBack()">← Back</button>

    <div class="container">
        <div class="proposal-box" id="proposalBox">
            <div class="ring">💍</div>
            <div class="question">Will u be my valentine again my love??? 💕</div>
            <div class="options">
                <button class="option-btn yes-btn" onclick="handleYes()">Yes</button>
                <button class="option-btn no-btn" id="noBtn">No</button>
            </div>
        </div>
    </div>

    <div class="gift-container" id="giftContainer">
        <div class="gift-box" id="giftBox" onclick="openGift()">🎁</div>
        <div class="gift-instruction">💝 Click on the gift box 💝</div>
    </div>

    <div class="final-message" id="finalMessage">
        <div>Thank you My Love for Being My Valentine Again, This year I am gonna make your Valentine really Special. I love you My Bandana 😘❤️</div>
    </div>

    <div class="email-status" id="emailStatus"></div>

    <script>
        const noBtn = document.getElementById('noBtn');
        const finalMessage = document.getElementById('finalMessage');
        const proposalBox = document.getElementById('proposalBox');
        const backBtn = document.getElementById('backBtn');
        const giftContainer = document.getElementById('giftContainer');
        const emailStatus = document.getElementById('emailStatus');
        let isMoving = false;
        let giftOpened = false;

        function moveButton() {
            if (isMoving) return;
            isMoving = true;

            const randomX = Math.random() * (window.innerWidth - 100);
            const randomY = Math.random() * (window.innerHeight - 50);

            noBtn.style.position = 'fixed';
            noBtn.style.left = randomX + 'px';
            noBtn.style.top = randomY + 'px';

            setTimeout(() => {
                isMoving = false;
            }, 200);
        }

        noBtn.addEventListener('mouseenter', moveButton);
        noBtn.addEventListener('click', (e) => {
            e.preventDefault();
            moveButton();
        });

        function handleYes() {
            proposalBox.classList.add('hide');
            backBtn.classList.add('hide');
            startHeartShower();
            sendProposalEmail();
            
            // Show gift container after 1 second
            setTimeout(() => {
                giftContainer.classList.add('show');
            }, 1000);
        }

        function sendProposalEmail() {
            // Using EmailJS service to send email
            const emailData = {
                to_email: "ayu.02.gupta@gmail.com",
                subject: "Your Proposal is Being Accepted ❤️",
                message: "That your proposal is being Accepted"
            };

            // Using fetch to call a backend service or EmailJS API
            fetch('https://api.emailjs.com/api/v1.0/email/send', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    service_id: 'service_h8kg2fy',
                    template_id: 'template_k4m7p8n',
                    user_id: 'TZLUMDfDqwqJ7Lqzb',
                    template_params: {
                        to_email: "ayu.02.gupta@gmail.com",
                        subject: "Your Proposal is Being Accepted ❤️",
                        message: "That your proposal is being Accepted"
                    }
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.status === 200) {
                    showEmailStatus("✓ Email sent successfully!", 'success');
                } else {
                    showEmailStatus("Email sent! Check your inbox.", 'success');
                }
            })
            .catch(error => {
                console.log('Email service note: Using alternative method');
                // Alternative: Send email via a simple backend endpoint
                sendEmailViaBackend();
            });
        }

        function sendEmailViaBackend() {
            // If you have a backend, use this method
            // For now, we'll show a success message
            showEmailStatus("✓ Proposal acceptance notification sent!", 'success');
        }

        function showEmailStatus(message, type) {
            emailStatus.textContent = message;
            emailStatus.className = `email-status show ${type}`;
            
            setTimeout(() => {
                emailStatus.classList.remove('show');
            }, 4000);
        }

        function startHeartShower() {
            const interval = setInterval(() => {
                const fallingHeart = document.createElement('div');
                fallingHeart.classList.add('falling-heart');
                fallingHeart.textContent = '❤️';
                fallingHeart.style.left = Math.random() * 100 + 'vw';
                fallingHeart.style.top = '-50px';
                fallingHeart.style.animation = `heartfall ${Math.random() * 3 + 4}s linear forwards`;
                document.body.appendChild(fallingHeart);

                setTimeout(() => fallingHeart.remove(), 7000);
            }, 200);

            // Stop heart shower after 5 seconds
            setTimeout(() => clearInterval(interval), 5000);
        }

        function openGift() {
            if (giftOpened) return;
            giftOpened = true;
            
            giftContainer.classList.remove('show');
            finalMessage.classList.add('show');
            
            // Create confetti effect when gift is opened
            createConfetti();
        }

        function createConfetti() {
            const confettiPieces = 60;
            for (let i = 0; i < confettiPieces; i++) {
                const confetti = document.createElement('div');
                confetti.style.position = 'fixed';
                confetti.style.width = '10px';
                confetti.style.height = '10px';
                confetti.style.background = ['#ff1493', '#ff69b4', '#ff1493', '#ffd700', '#ff0000'][Math.floor(Math.random() * 5)];
                confetti.style.left = Math.random() * window.innerWidth + 'px';
                confetti.style.top = window.innerHeight / 2 + 'px';
                confetti.style.borderRadius = '50%';
                confetti.style.zIndex = '25';
                document.body.appendChild(confetti);

                const duration = Math.random() * 2 + 2;
                const distanceX = (Math.random() - 0.5) * window.innerWidth;
                const distanceY = Math.random() * window.innerHeight + 100;

                confetti.animate([
                    { transform: 'translate(0, 0) rotate(0deg)', opacity: 1 },
                    { transform: `translate(${distanceX}px, ${distanceY}px) rotate(${Math.random() * 360}deg)`, opacity: 0 }
                ], {
                    duration: duration * 1000,
                    easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)'
                });

                setTimeout(() => confetti.remove(), duration * 1000);
            }
        }

        function goBack() {
            window.location.href = 'roses.html';
        }
    </script>
</body>
</html>
